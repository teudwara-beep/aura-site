# Required admin account. Create your own strong values in a private .env file.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password-to-a-long-random-value
SESSION_SECRET=replace-with-at-least-32-random-characters-here

# Local admin address: http://admin.localhost:4180
# Production: replace with your real subdomain (example: admin.example.com).
# If left blank during development, the server still uses admin.localhost.
ADMIN_HOST=admin.localhost

# Optional local server settings
NODE_ENV=development
HOST=127.0.0.1
PORT=4180
MAX_UPLOAD_MB=2048
# Allow slow uploads up to this many minutes (Node defaults to only five).
REQUEST_TIMEOUT_MINUTES=60
DATA_DIR=./data
VIDEO_DIR=./storage/videos

# Optional Bunny Stream. Create a STREAM Video Library first; values belong in
# your private .env, never in the public site, ZIP, GitHub, or a chat message.
# Enable Stream > Library > Security > Embed view token authentication, then
# copy that token security key separately from the library API key.
# BUNNY_LIBRARY_ID=123456
# BUNNY_STREAM_API_KEY=your-private-stream-library-api-key
# BUNNY_TOKEN_KEY=your-private-embed-token-security-key
# BUNNY_PULL_ZONE=your-pull-zone.b-cdn.net

# Set to 1 ONLY when a reverse proxy connects to Node over 127.0.0.1 and
# overwrites X-Forwarded-For with the true visitor address (report and admin
# login rate limits). Otherwise all visitors through that proxy share one IP.
REPORT_TRUST_PROXY=0
